# OpenRouter / TypeSafe API Key（请在此填入你在 openrouter.ai 申请的 API Key）
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Jev 模型型号，建议指定具体版本避免漂移，如 typesafe/jev-1.13，也支持 typesafe/jev-latest
TYPESAFE_MODEL=typesafe/jev-1.13

# OpenRouter 基础接口地址
TYPESAFE_BASE_URL=https://openrouter.ai/api

# 服务监听配置
HOST=0.0.0.0
PORT=8000
